generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  PARENT
  TUTOR
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DocumentType {
  DEGREE
  CERTIFICATE
  IDENTITY
  TRANSCRIPT
  OTHER
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REMOVED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile?
  parent  ParentProfile?
  tutor   TutorProfile?

  messages Message[]

  conversationParticipants ConversationParticipant[]

  createdConversations Conversation[] @relation("ConversationCreator")

  notifications Notification[]
  reports       Report[]       @relation("Reporter")
  auditLogs     AuditLog[]     @relation("AuditActor")

  reviewsGiven Review[] @relation("ReviewAuthor")
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
phone String?
  dateOfBirth DateTime
  gender      Gender
  grade       String
  schoolName  String?

  bio           String?
  learningNeeds String?
  languages     String[]

  independentRequestEligible Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentRelationships ParentStudent[]

  subjects      StudentSubject[]
  availability  StudentAvailability[]
  learningGoals LearningGoal[]

  budget Budget?

  tutorRequests TutorRequest[] @relation("StudentRequests")

  bookings Booking[]

  reviews Review[] @relation("StudentReviews")

  assessments Assessment[]

  progressRecords ProgressRecord[]
}

model ParentProfile {
  id     String @id @default(cuid())
  userId String @unique
  phone String?

  dateOfBirth DateTime?
  gender      Gender?
  phone       String?

  occupation String?
  address    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  children ParentStudent[]

  tutorRequests TutorRequest[] @relation("ParentRequests")
}

model ParentStudent {
  id        String @id @default(cuid())
  parentId  String
  studentId String

  relationship String
  isPrimary    Boolean @default(false)

  createdAt DateTime @default(now())

  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model TutorProfile {
  id     String @id @default(cuid())
  userId String @unique
  phone String?

  dateOfBirth DateTime
  gender      Gender

  bio             String?
  experienceYears Int?

  verificationStatus VerificationStatus @default(PENDING)

  verifiedAt DateTime?

  languages String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  educationRecords EducationRecord[]

  documents TutorDocument[]

  subjects TutorSubject[]

  availability TutorAvailability[]

  pricing TutorPricing[]

  tutorRequests TutorRequest[]

  bookings Booking[]

  reviews Review[] @relation("TutorReviews")
}

model EducationRecord {
  id      String @id @default(cuid())
  tutorId String

  degree         String
  department     String?
  institution    String
  graduationYear Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
}

model TutorDocument {
  id      String @id @default(cuid())
  tutorId String

  type  DocumentType
  title String

  fileUrl  String
  fileName String
  mimeType String
  fileSize Int

  verificationStatus VerificationStatus @default(PENDING)

  extractedText String?

  uploadedAt DateTime  @default(now())
  verifiedAt DateTime?

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
}

model Subject {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())

  tutors   TutorSubject[]
  students StudentSubject[]
}

model TutorSubject {
  id        String @id @default(cuid())
  tutorId   String
  subjectId String

  proficiencyLevel String?
  gradeLevels      String[]

  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tutorId, subjectId])
}

model StudentSubject {
  id        String @id @default(cuid())
  studentId String
  subjectId String

  currentLevel String?
  needsHelp    Boolean @default(true)

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
}

model LearningGoal {
  id        String @id @default(cuid())
  studentId String

  title       String
  description String?

  priority Int @default(1)

  createdAt DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Budget {
  id        String @id @default(cuid())
  studentId String @unique

  maxAmount Decimal
  currency  String  @default("ETB")

  period String?

  isFlexible Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model TutorAvailability {
  id      String @id @default(cuid())
  tutorId String

  dayOfWeek Int

  startTime String
  endTime   String

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, dayOfWeek])
}

model TutorPricing {
  id      String @id @default(cuid())
  tutorId String

  amount   Decimal
  currency String  @default("ETB")

  durationMinutes Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
}

model TutorRequest {
  id String @id @default(cuid())

  studentId String?
  parentId  String?
  tutorId   String

  status RequestStatus @default(PENDING)

  message String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile? @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)

  parent ParentProfile? @relation("ParentRequests", fields: [parentId], references: [id], onDelete: Cascade)

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  booking Booking?

  @@index([tutorId, status])
  @@index([studentId, status])
  @@index([parentId, status])
}

model Booking {
  id String @id @default(cuid())

  requestId String @unique

  studentId String
  tutorId   String

  startTime DateTime
  endTime   DateTime

  amount Decimal @db.Decimal(10, 2)

  status BookingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request TutorRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  session Session?

  payment Payment?

  @@index([studentId, startTime])
  @@index([tutorId, startTime])
}

model Session {
  id        String @id @default(cuid())
  bookingId String @unique

  status SessionStatus @default(SCHEDULED)

  startedAt   DateTime?
  completedAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  attendance Attendance?
}

model Attendance {
  id        String @id @default(cuid())
  sessionId String @unique

  present Boolean @default(false)

  joinedAt DateTime?
  leftAt   DateTime?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String @id @default(cuid())
  bookingId String @unique

  amount   Decimal
  currency String  @default("ETB")

  provider      String?
  transactionId String?

  status PaymentStatus @default(PENDING)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Conversation {
  id String @id @default(cuid())

  creatorId String

  status ConversationStatus @default(OPEN)

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  creator User @relation("ConversationCreator", fields: [creatorId], references: [id])

  participants ConversationParticipant[]

  messages Message[]
}

model ConversationParticipant {
  id String @id @default(cuid())

  conversationId String
  userId         String

  joinedAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id String @id @default(cuid())

  conversationId String
  senderId       String

  content String

  createdAt DateTime  @default(now())
  readAt    DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Review {
  id String @id @default(cuid())

  tutorId   String
  studentId String
  authorId  String

  rating  Int
  comment String?

  status ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor TutorProfile @relation("TutorReviews", fields: [tutorId], references: [id], onDelete: Cascade)

  student StudentProfile @relation("StudentReviews", fields: [studentId], references: [id], onDelete: Cascade)

  author User @relation("ReviewAuthor", fields: [authorId], references: [id])

  @@index([tutorId])
}

model Assessment {
  id        String @id @default(cuid())
  studentId String

  title       String
  description String?

  score    Decimal?
  maxScore Decimal?

  createdAt DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model ProgressRecord {
  id        String @id @default(cuid())
  studentId String

  subjectId String?

  metric String
  value  Decimal

  recordedAt DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, recordedAt])
}

model Notification {
  id     String @id @default(cuid())
  userId String

  title   String
  message String

  read Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Report {
  id String @id @default(cuid())

  reporterId String

  targetType String
  targetId   String

  reason      String
  description String?

  status ReportStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter User @relation("Reporter", fields: [reporterId], references: [id])

  @@index([targetType, targetId])
}

model AuditLog {
  id String @id @default(cuid())

  actorId String?

  action   String
  entity   String
  entityId String?

  metadata Json?

  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

model StudentAvailability {
  id        String @id @default(cuid())
  studentId String

  dayOfWeek Int
  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, dayOfWeek])
}
